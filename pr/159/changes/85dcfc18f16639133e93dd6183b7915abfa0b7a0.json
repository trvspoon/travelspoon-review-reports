ess.env,","+  });"," }"," ","-function runHook(repository, input = {}) {","+function runHook(cwd, input = {}) {","   const result = spawnSync('node', [script], {","-    cwd: repository,","+    cwd,","     input: JSON.stringify(input),","     encoding: 'utf8',","   });"],"why":"세션 시각, 작업 디렉터리, 커밋별 예외가 달라져도 올바르게 지시하는지 검증해야 합니다.","how":"테스트에서 커밋별 파일·본문을 준비하고 바뀐 집계 결과를 검사합니다."},{"a":103,"b":123,"lines":["   return { root, repository };"," }"," ","-test('새 앱 코드 커밋마다 한 번씩만 대조를 지시한다', () => {","-  const { root, repository } = createRepository();","+function withRepository(run) {","+  const context = createRepository();","   try {","+    run(context);","+  } finally {","+    rmSync(context.root, { recursive: true, force: true });","+  }","+}","+","+test('새 앱 코드 변경마다 한 번씩만 대조를 지시한다', () => {","+  withRepository(({ repository }) => {","     // 기준 브랜치에 이미 있는 앱 코드 변경은 대상이 아니다.","     assert.equal(runHook(repository), null);"," "],"why":"세션 시각, 작업 디렉터리, 커밋별 예외가 달라져도 올바르게 지시하는지 검증해야 합니다.","how":"각 테스트가 만든 임시 저장소를 종료 시 정리하도록 공통 처리합니다."},{"a":129,"b":157,"lines":["     const second = runHook(repository);","     assert.equal(second.decision, 'block');","     assert.match(second.reason, /docs\\/qa\\/x_test_cases\\.md/u);","-  } finally {","-    rmSync(root, { recursive: true, force: true });","-  }","+  });"," });"," "," test('앱 코드를 바꾸지 않은 커밋에는 지시하지 않는다', () => {","-  const { root, repository } = createRepository();","-  try {","+  withRepository(({ repository }) => {","     git(repository, 'switch', '-q', '-c', 'docs/x');","     commitFile(repository, 'DESIGN.md', 'docs: design');","     commitFile(repository, 'lib/l10n/generated/app.dart', 'chore: gen');","     assert.equal(runHook(repository), null);","-  } finally {","-    rmSync(root, { recursive: true, force: true });","-  }","+  });","+});","+","+test('세션이 시작되기 전에 만들어진 커밋에는 지시하지 않는다', () => {","+  withRepository(({ root, repository }) => {","+    git(repository, 'switch', '-q', '-c', 'feature/other');","+    commitFile(repository, 'lib/pages/old.dart', 'feat: old', {","+      date: '2020-01-01T00:00:00Z',","+    });","+    // 대화 기록 파일의 생성 시각을 세션 시작으로 본다.","+    const transcript = join(root, 'transcript.jsonl');","+    writeFileSync(transcript, '');","+","+    assert.equal(runHook(repository, { transcript_path: transcript }), null);","+","+    commitFile(repository, 'lib/pages/new.dart', 'feat: new');","+    const prompted = runHook(repository, { transcript_path: transcript });","+    assert.equal(prompted.decision, 'block');","+    assert.match(prompted.reason, /feat: new/u);","+    assert.doesNotMatch(prompted.reason, /feat: old/u);","+    assert.doesNotMatch(prompted.reason, /old\\.dart/u);","+  });","+});","+","+test('브랜치를 오가도 이미 지시한 변경은 다시 지시하지 않는다', () => {","+  withRepository(({ repository }) => {","+    git(repository, 'switch', '-q', '-c', 'feature/a');","+    commitFile(repository, 'lib/pages/a.dart', 'feat: a');","+    git(repository, 'switch', '-q', 'main');","+    git(repository, 'switch', '-q', '-c', 'feature/b');","+    commitFile(repository, 'lib/pages/b.dart', 'feat: b');","+","+    git(repository, 'switch', '-q', 'feature/a');","+    assert.equal(runHook(repository).decision, 'block');","+    git(repository, 'switch', '-q', 'feature/b');","+    assert.equal(runHook(repository).decision, 'block');","+    git(repository, 'switch', '-q', 'feature/a');","+    assert.equal(runHook(repository), null);","+  });","+});","+","+test('커밋 메시지만 고쳐도 다시 지시하지 않는다', () => {","+  withRepository(({ repository }) => {","+    git(repository, 'switch', '-q', '-c', 'feature/x');","+    commitFile(repository, 'lib/pages/a.dart', 'feat: a');","+    assert.equal(runHook(repository).decision, 'block');","+    git(repository, 'commit', '-q', '--amend', '-m', 'feat: a (메시지 수정)');","+    assert.equal(runHook(repository), null);","+  });","+});","+","+test('하위 폴더에서 실행해도 앱 코드 커밋을 찾는다', () => {","+  withRepository(({ repository }) => {","+    git(repository, 'switch', '-q', '-c', 'feature/x');","+    commitFile(repository, 'lib/pages/a.dart', 'feat: a');","+    const prompted = runHook(join(repository, 'lib'));","+    assert.equal(prompted.decision, 'block');","+    assert.match(prompted.reason, /lib\\/pages\\/a\\.dart/u);","+  });","+});","+","+test('예외 커밋과 기능 커밋이 섞이면 QA TC 대조를 요청한다', () => {","+  withRepository(({ repository }) => {","+    git(repository, 'switch', '-q', '-c', 'feature/x');","+    mkdirSync(join(repository, 'lib'), { recursive: true });","+    writeFileSync(join(repository, 'lib/r.dart'), 'r\\n');","+    git(repository, 'add', '.');","+    git(repository, 'commit', '-q', '-m', 'refactor: r', '-m', 'QA-TC: 해당 없음 - 이름 정리');","+    commitFile(repository, 'lib/f.dart', 'feat: f');","+","+    const prompted = runHook(repository);","+    assert.match(prompted.reason, /사전조건/u);","+    assert.match(prompted.reason, /refactor: r.*QA TC 대조 생략/u);","+  });","+});","+","+test('병합하며 충돌을 풀어 바꾼 앱 코드도 대상이다', () => {","+  withRepository(({ repository }) => {","+    git(repository, 'switch', '-q', '-c', 'release/1.0');","+    commitFile(repository, 'lib/base.dart', 'feat: release', { content: 'release' });","+    git(repository, 'push', '-q', 'origin', 'release/1.0');","+    git(repository, 'switch', '-q', 'main');","+    commitFile(repository, 'lib/base.dart', 'feat: main', { content: 'main' });","+    git(repository, 'push', '-q', 'origin', 'main');","+    git(repository, 'fetch', '-q', 'origin');","+","+    git(repository, 'switch', '-q', '-c', 'merge/x');","+    spawnSync('git', ['merge', '-q', 'origin/release/1.0'], { cwd: repository });","+    writeFileSync(join(repository, 'lib/base.dart'), 'resolved differently\\n');","+    git(repository, 'add', 'lib/base.dart');","+    git(repository, 'commit', '-q', '-m', 'merge: release into main');","+","+    const prompted = runHook(repository);","+    assert.equal(prompted.decision, 'block');","+    assert.match(prompted.reason, /lib\\/base\\.dart/u);","+  });","+});","+","+test('충돌 없는 병합은 지시를 부르지 않는다', () => {","+  withRepository(({ repository }) => {","+    git(repository, 'switch', '-q', '-c', 'release/1.0');","+    commitFile(repository, 'lib/release.dart', 'feat: release');","+    git(repository, 'push', '-q', 'origin', 'release/1.0');","+    git(repository, 'switch', '-q', 'main');","+    commitFile(repository, 'lib/main.dart', 'feat: main');","+    git(repository, 'push', '-q', 'origin', 'main');","+    git(repository, 'fetch', '-q', 'origin');","+","+    git(repository, 'switch', '-q', '-c', 'merge/y');","+    git(repository, 'merge', '-q', '--no-edit', 'origin/release/1.0');","+    assert.equal(runHook(repository), null);","+  });","+});","+","+test('한글 파일명도 목록에 그대로 나온다', () => {","+  withRepository(({ repository }) => {","+    git(repository, 'switch', '-q', '-c', 'feature/ko');","+    commitFile(repository, 'lib/pages/한글.dart', 'feat: ko');","+    assert.match(runHook(repository).reason, /lib\\/pages\\/한글\\.dart/u);","+  });"," });"," "," test('이미 훅 때문에 이어서 작업 중이면 막지 않는다', () => {","-  const { root, repository } = createRepository();","-  try {","+  withRepository(({ repository }) => {","     git(repository, 'switch', '-q', '-c', 'feature/y');","     commitFile(repository, 'lib/pages/a.dart', 'feat: a');","     assert.equal(runHook(repository, { stop_hook_active: true }), null);","-  } finally {","-    rmSync(root, { recursive: true, force: true });","-  }","+  });"," });"," "," test('git 저장소가 아니면 조용히 통과한다', () => {"],"why":"세션 시각, 작업 디렉터리, 커밋별 예외가 달라져도 올바르게 지시하는지 검증해야 합니다.","how":"세션 시작 이전 커밋 등 경계 사례를 임시 저장소에 만들어 검사합니다."}]}]}