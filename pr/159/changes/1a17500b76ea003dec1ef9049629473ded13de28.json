{"parent":"783e34d0822744f031b91e4f9d41bf7d45ba139f","commit":"1a17500b76ea003dec1ef9049629473ded13de28","files":[{"path":".claude/settings.json","hunks":[{"a":5,"b":5,"lines":["         \"hooks\": [","           {","             \"type\": \"command\",","-            \"command\": \"f=\\\"$(git rev-parse --show-toplevel 2>/dev/null)/tool/qa_tc_commit_check.mjs\\\"; if [ -f \\\"$f\\\" ]; then node \\\"$f\\\"; fi\",","+            \"command\": \"f=\\\"$(git rev-parse --show-toplevel 2>/dev/null)/tool/commit_review_prompt.mjs\\\"; if [ -f \\\"$f\\\" ]; then node \\\"$f\\\"; fi\",","             \"timeout\": 20,","-            \"statusMessage\": \"QA TC 반영 여부 확인 중\"","+            \"statusMessage\": \"커밋한 변경의 문서 대조 필요 여부 확인 중\"","           }","         ]","       }"],"why":"QA 파일을 고쳤는지만으로는 코드와 테스트 내용이 실제로 맞는지 판정할 수 없습니다.","how":"Stop 훅 설정을 해당 호스트의 공통 검사 명령에 연결합니다."}]},{"path":"docs/agent-guideline/docs-sync-and-todo.md","hunks":[{"a":43,"b":43,"lines":[" - **자동 검증만 가능한 동작:** 수동으로 재현할 수 없으면 TC를 억지로 만들지 않습니다. 명세 `검증` 항목에 자동 테스트 위치를 적습니다."," - **참조 갱신:** 명세의 QA 줄, [앱 화면 지도](../qa/screen_map.md)의 진입 경로, 에이전트 지침의 TC 링크를 새 ID에 맞춥니다."," - **PR 기록:** PR 템플릿의 `QA TC` 줄에 추가·수정한 ID를 적습니다. 해당 TC가 없으면 `해당 없음`과 사유를 적습니다.","-- **자동 확인:** Claude Code는 응답을 마칠 때 `tool/qa_tc_commit_check.mjs`를 실행합니다(`.claude/settings.json`의 Stop 훅). 기준 브랜치(`origin/main`, `origin/release/*`)에 없는 커밋이 `lib/`를 바꿨는데 `docs/qa/`는 바꾸지 않았으면 한 번 멈추고 이유를 알립니다. 사용자가 쓰는 기능이 바뀌지 않았다면 커밋 메시지에 `QA-TC: 해당 없음 - <사유>` 줄을 넣습니다. 이 검사는 TC 파일을 고쳤는지만 보므로, 맞는 TC를 맞게 고쳤는지는 위 기준으로 직접 대조합니다. 검사 자체의 테스트는 `node --test tool/qa_tc_commit_check.test.mjs`로 실행합니다.","+- **자동 대조 지시:** Claude Code는 응답을 마칠 때 `tool/commit_review_prompt.mjs`를 실행합니다(`.claude/settings.json`의 Stop 훅). 기준 브랜치(`origin/main`, `origin/release/*`)에 없는 커밋이 `lib/`를 바꿨으면 한 번 멈추고, 그 변경을 QA TC·문서와 대조하라는 지시를 에이전트에게 보냅니다. 스크립트는 대조할 시점만 정하고 문서가 맞는지는 판정하지 않습니다. 대조는 별도 하위 에이전트에게 맡기고, 확인한 TC ID·문서와 고친 내용을 사용자에게 보고합니다. 앱 코드를 바꾼 커밋이 새로 생길 때마다 한 번씩 지시하며, TC·문서만 고친 커밋은 다시 지시를 부르지 않습니다. 사용자가 쓰는 기능이 바뀌지 않았다면 커밋 메시지에 `QA-TC: 해당 없음 - <사유>` 줄을 넣어 QA TC 대조를 생략합니다(문서 정확성 확인은 그대로 합니다). 스크립트 테스트는 `node --test tool/commit_review_prompt.test.mjs`로 실행합니다."," "," ## 권장 필드"," - 상태"],"why":"QA 파일을 고쳤는지만으로는 코드와 테스트 내용이 실제로 맞는지 판정할 수 없습니다.","how":"실행 주체, 스크립트 경로, 응답 종료 시 문서 대조 절차를 지침에 기록합니다."}]},{"path":"tool/commit_review_prompt.mjs","hunks":[{"a":0,"b":1,"lines":["+#!/usr/bin/env node","+","+// Claude Code Stop 훅에서 실행한다. 기준 브랜치에 아직 없는 커밋이 앱 코드를","+// 바꿨으면 응답 종료를 한 번 막고, 그 변경을 QA TC·문서와 대조하라는 지시문을","+// 에이전트에게 돌려준다. 이 스크립트는 \"언제 대조할지\"만 정하고, 문서가 맞는지는","+// 판정하지 않는다. 기준은 docs/agent-guideline/docs-sync-and-todo.md를 따른다.","+","+import { execFileSync } from 'node:child_process';","+import { createHash } from 'node:crypto';","+import { existsSync, readFileSync, writeFileSync } from 'node:fs';","+import { join, resolve } from 'node:path';","+import { fileURLToPath } from 'node:url';","+","+const codePathspec = ['--', 'lib', ':(exclude)lib/l10n/generated'];","+const codePattern = /^lib\\//u;","+const generatedPattern = /^lib\\/l10n\\/generated\\//u;","+const qaPattern = /^docs\\/qa\\//u;","+// 사유가 있어야 예외로 인정한다. PR 템플릿의 \"QA TC: 해당 없음과 사유\"와 같은 기준이다.","+const waiverPattern = /^QA-TC:\\s*해당 없음\\s*[-–—:]\\s*\\S/mu;","+const stateFileName = 'commit-review-prompted';","+const maxListed = 10;","+","+export function classify({ changedFiles, messages }) {","+  return {","+    codeFiles: changedFiles.filter(","+      (file) => codePattern.test(file) && !generatedPattern.test(file),","+    ),","+    qaFiles: changedFiles.filter((file) => qaPattern.test(file)),","+    qaWaived: waiverPattern.test(messages),","+  };","+}","+","+function bullets(items) {","+  const listed = items.slice(0, maxListed).map((item) => `- ${item}`);","+  if (items.length > maxListed) {","+    listed.push(`- 외 ${items.length - maxListed}개`);","+  }","+  return listed;","+}","+","+export function buildPrompt({ codeFiles, qaFiles, qaWaived, commits }) {","+  const checks = [];","+  if (!qaWaived) {","+    checks.push(","+      'QA TC: docs/qa에서 바뀐 화면·동작을 다루는 TC를 찾아 사전조건·절차·기대 결과가 새 동작과 맞는지 한 항목씩 대조한다. 대응하는 TC가 없는 변경도 찾는다. 기준은 docs/agent-guideline/docs-sync-and-todo.md의 \"QA TC 동시 갱신\"이다.',","+    );","+  }","+  checks.push(","+    '문서 정확성: 바뀐 코드를 설명하는 문서(DESIGN.md, docs/product, docs/agent-guideline 등)의 서술·경로·값이 여전히 맞는지 확인한다.',","+  );","+","+  return [","+    '이번 작업에서 커밋한 앱 코드 변경을 문서와 대조할 차례입니다. 응답을 마치기 전에 아래를 수행하세요.',","+    '',","+    '기준 브랜치에 없는 커밋 중 앱 코드를 바꾼 것:',","+    ...bullets(commits),","+    '',","+    '바뀐 앱 코드:',","+    ...bullets(codeFiles),","+    '',","+    qaFiles.length > 0","+      ? '같은 범위에서 바뀐 QA TC 파일(고쳤다는 사실만으로 맞다고 보지 않는다):'","+      : '같은 범위에서 바뀐 QA TC 파일: 없음',","+    ...bullets(qaFiles),","+    '',","+    '대조는 이 변경을 만든 세션이 직접 하지 말고 별도 하위 에이전트에게 맡깁니다. 결론을 미리 알려주지 말고, 위 커밋과 파일 목록만 주고 다음을 확인하게 하세요.',","+    ...checks.map((check, index) => `${index + 1}. ${check}`),","+    '',","+    '하위 에이전트의 결과를 직접 검토한 뒤, 맞지 않는 TC와 문서를 고치고 필요한 TC를 추가합니다.',","+    '마지막으로 사용자에게 확인한 TC ID와 문서, 고친 내용, 고칠 필요가 없다고 판단한 항목과 그 이유를 보고합니다.',","+    ...(qaWaived","+      ? ['커밋 메시지에 `QA-TC: 해당 없음` 사유가 있어 QA TC 대조는 생략했습니다.']","+      : ['사용자가 쓰는 기능이 바뀌지 않았다면 커밋 메시지에 `QA-TC: 해당 없음 - <사유>` 줄을 넣어 QA TC 대조를 생략할 수 있습니다.']),","+    '',","+    '이 지시는 앱 코드를 바꾼 커밋이 새로 생기기 전에는 다시 오지 않습니다.',","+  ].join('\\n');","+}","+","+function git(cwd, args) {","+  return execFileSync('git', args, {","+    cwd,","+    encoding: 'utf8',","+    stdio: ['ignore', 'pipe', 'ignore'],","+  }).trim();","+}","+","+function lines(text) {","+  return text.split('\\n').filter(Boolean);","+}","+","+function readHookInput() {","+  try {","+    return JSON.parse(readFileSync(0, 'utf8') || '{}');","+  } catch {","+    return {};","+  }","+}","+","+function main() {","+  const input = readHookInput();","+  // 이 훅이 막아서 이어진 응답이면 다시 막지 않는다.","+  if (input.stop_hook_active === true) return;","+","+  const cwd = process.cwd();","+  let gitDirectory;","+  let baseRefs;","+  try {","+    gitDirectory = resolve(cwd, git(cwd, ['rev-parse', '--git-dir']));","+    baseRefs = lines(git(cwd, [","+      'for-each-ref',","+      '--format=%(refname)',","+      'refs/remotes/origin/main',","+      'refs/remotes/origin/release',","+    ]));","+  } catch {","+    return;","+  }","+  // 기준 브랜치를 알 수 없으면 어디까지가 이번 작업인지 판단할 수 없다.","+  if (baseRefs.length === 0) return;","+","+  const range = ['--no-merges', 'HEAD', '--not', ...baseRefs];","+  let codeCommits;","+  let changedFiles;","+  let messages;","+  try {","+    codeCommits = lines(git(cwd, ['log', '--format=%H %h %s', ...range, ...codePathspec]));","+    if (codeCommits.length === 0) return;","+    changedFiles = [...new Set(lines(git(cwd, ['log', '--name-only', '--format=', ...range])))];","+    messages = git(cwd, ['log', '--format=%B', ...range]);","+  } catch {","+    return;","+  }","+","+  // 앱 코드를 바꾼 커밋 집합이 같으면 다시 지시하지 않는다. 대조 결과로 TC·문서만","+  // 고친 커밋이 지시를 다시 부르지 않게 하려고 HEAD가 아니라 이 집합을 기준으로 한다.","+  const key = createHash('sha256')","+    .update(codeCommits.map((commit) => commit.split(' ', 1)[0]).join('\\n'))","+    .digest('hex');","+  const stateFile = join(gitDirectory, stateFileName);","+  if (existsSync(stateFile) && readFileSync(stateFile, 'utf8').trim() === key) {","+    return;","+  }","+  writeFileSync(stateFile, `${key}\\n`);","+","+  const prompt = buildPrompt({","+    ...classify({ changedFiles, messages }),","+    commits: codeCommits.map((commit) => commit.slice(commit.indexOf(' ') + 1)),","+  });","+  process.stdout.write(JSON.stringify({ decision: 'block', reason: prompt }));","+}","+","+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {","+  main();","+}"],"why":"QA 파일을 고쳤는지만으로는 코드와 테스트 내용이 실제로 맞는지 판정할 수 없습니다.","how":"기준 브랜치 밖의 앱 코드 커밋을 선별해 QA·명세 대조를 요청하는 안내를 생성합니다."}]},{"path":"tool/commit_review_prompt.test.mjs","hunks":[{"a":0,"b":1,"lines":["+import assert from 'node:assert/strict';","+import { execFileSync, spawnSync } from 'node:child_process';","+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';","+import { tmpdir } from 'node:os';","+import { dirname, join } from 'node:path';","+import { test } from 'node:test';","+import { fileURLToPath } from 'node:url';","+","+import { buildPrompt, classify } from './commit_review_prompt.mjs';","+","+const script = join(","+  dirname(fileURLToPath(import.meta.url)),","+  'commit_review_prompt.mjs',","+);","+","+test('앱 코드와 QA TC 파일을 나눠 분류한다', () => {","+  const result = classify({","+    changedFiles: [","+      'lib/pages/a.dart',","+      'lib/l10n/generated/app_localizations.dart',","+      'docs/qa/my_groups_test_cases.md',","+      'test/a_test.dart',","+    ],","+    messages: 'feat: a',","+  });","+  assert.deepEqual(result.codeFiles, ['lib/pages/a.dart']);","+  assert.deepEqual(result.qaFiles, ['docs/qa/my_groups_test_cases.md']);","+  assert.equal(result.qaWaived, false);","+});","+","+test('사유가 있는 해당 없음만 QA TC 대조 예외로 인정한다', () => {","+  const withReason = classify({","+    changedFiles: ['lib/pages/a.dart'],","+    messages: 'refactor: a\\n\\nQA-TC: 해당 없음 - 동작 변경 없는 이름 정리',","+  });","+  const withoutReason = classify({","+    changedFiles: ['lib/pages/a.dart'],","+    messages: 'refactor: a\\n\\nQA-TC: 해당 없음',","+  });","+  assert.equal(withReason.qaWaived, true);","+  assert.equal(withoutReason.qaWaived, false);","+});","+","+test('지시문은 판정하지 않고 하위 에이전트 대조와 보고를 요구한다', () => {","+  const prompt = buildPrompt({","+    codeFiles: ['lib/pages/a.dart'],","+    qaFiles: ['docs/qa/my_groups_test_cases.md'],","+    qaWaived: false,","+    commits: ['abc1234 feat: a'],","+  });","+  assert.match(prompt, /lib\\/pages\\/a\\.dart/u);","+  assert.match(prompt, /abc1234 feat: a/u);","+  assert.match(prompt, /docs\\/qa\\/my_groups_test_cases\\.md/u);","+  assert.match(prompt, /하위 에이전트/u);","+  assert.match(prompt, /QA TC/u);","+  assert.match(prompt, /문서 정확성/u);","+  assert.match(prompt, /보고/u);","+});","+","+test('QA TC 대조 예외면 문서 정확성만 요청한다', () => {","+  const prompt = buildPrompt({","+    codeFiles: ['lib/pages/a.dart'],","+    qaFiles: [],","+    qaWaived: true,","+    commits: ['abc1234 refactor: a'],","+  });","+  assert.doesNotMatch(prompt, /사전조건/u);","+  assert.match(prompt, /문서 정확성/u);","+});","+","+function git(cwd, ...args) {","+  return execFileSync('git', args, { cwd, encoding: 'utf8' }).trim();","+}","+","+function commitFile(repository, path, message) {","+  mkdirSync(dirname(join(repository, path)), { recursive: true });","+  writeFileSync(join(repository, path), `${message}\\n`);","+  git(repository, 'add', path);","+  git(repository, 'commit', '-q', '-m', message);","+}","+","+function runHook(repository, input = {}) {","+  const result = spawnSync('node', [script], {","+    cwd: repository,","+    input: JSON.stringify(input),","+    encoding: 'utf8',","+  });","+  assert.equal(result.status, 0, result.stderr);","+  return result.stdout.trim() ? JSON.parse(result.stdout) : null;","+}","+","+function createRepository() {","+  const root = mkdtempSync(join(tmpdir(), 'commit-review-'));","+  const remote = join(root, 'remote.git');","+  const repository = join(root, 'work');","+  git(root, 'init', '-q', '--bare', '-b', 'main', remote);","+  git(root, 'clone', '-q', remote, repository);","+  git(repository, 'config', 'user.email', 'test@example.com');","+  git(repository, 'config', 'user.name', 'test');","+  commitFile(repository, 'lib/base.dart', 'chore: base');","+  git(repository, 'push', '-q', 'origin', 'HEAD:main');","+  git(repository, 'fetch', '-q', 'origin');","+  return { root, repository };","+}","+","+test('새 앱 코드 커밋마다 한 번씩만 대조를 지시한다', () => {","+  const { root, repository } = createRepository();","+  try {","+    // 기준 브랜치에 이미 있는 앱 코드 변경은 대상이 아니다.","+    assert.equal(runHook(repository), null);","+","+    git(repository, 'switch', '-q', '-c', 'feature/x');","+    commitFile(repository, 'lib/pages/a.dart', 'feat: a');","+","+    const first = runHook(repository);","+    assert.equal(first.decision, 'block');","+    assert.match(first.reason, /lib\\/pages\\/a\\.dart/u);","+    assert.match(first.reason, /feat: a/u);","+","+    // 같은 상태에서는 다시 지시하지 않는다.","+    assert.equal(runHook(repository), null);","+","+    // 대조 결과로 TC·문서만 고친 커밋은 다시 지시를 부르지 않는다.","+    commitFile(repository, 'docs/qa/x_test_cases.md', 'docs: tc');","+    assert.equal(runHook(repository), null);","+","+    // 앱 코드를 또 바꾸면 TC를 이미 건드렸어도 다시 대조를 지시한다.","+    commitFile(repository, 'lib/pages/b.dart', 'feat: b');","+    const second = runHook(repository);","+    assert.equal(second.decision, 'block');","+    assert.match(second.reason, /docs\\/qa\\/x_test_cases\\.md/u);","+  } finally {","+    rmSync(root, { recursive: true, force: true });","+  }","+});","+","+test('앱 코드를 바꾸지 않은 커밋에는 지시하지 않는다', () => {","+  const { root, repository } = createRepository();","+  try {","+    git(repository, 'switch', '-q', '-c', 'docs/x');","+    commitFile(repository, 'DESIGN.md', 'docs: design');","+    commitFile(repository, 'lib/l10n/generated/app.dart', 'chore: gen');","+    assert.equal(runHook(repository), null);","+  } finally {","+    rmSync(root, { recursive: true, force: true });","+  }","+});","+","+test('이미 훅 때문에 이어서 작업 중이면 막지 않는다', () => {","+  const { root, repository } = createRepository();","+  try {","+    git(repository, 'switch', '-q', '-c', 'feature/y');","+    commitFile(repository, 'lib/pages/a.dart', 'feat: a');","+    assert.equal(runHook(repository, { stop_hook_active: true }), null);","+  } finally {","+    rmSync(root, { recursive: true, force: true });","+  }","+});","+","+test('git 저장소가 아니면 조용히 통과한다', () => {","+  const directory = mkdtempSync(join(tmpdir(), 'commit-review-plain-'));","+  try {","+    assert.equal(runHook(directory), null);","+  } finally {","+    rmSync(directory, { recursive: true, force: true });","+  }","+});"],"why":"QA 파일을 고쳤는지만으로는 코드와 테스트 내용이 실제로 맞는지 판정할 수 없습니다.","how":"임시 Git 저장소와 테스트 커밋을 만들어 훅이 내는 지시와 예외 조건을 검증합니다."}]},{"path":"tool/qa_tc_commit_check.mjs","hunks":[{"a":1,"b"